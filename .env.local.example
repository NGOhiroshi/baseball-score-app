# Supabase の API 設定
# supabase.com で作成したプロジェクトの「Settings > API」から取得した値を貼り付ける
# このファイルを .env.local にコピーして実値を入れる（.env.local は git 管理外）

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...

# service_role キー（Settings > API の service_role）。
# ⚠️ サーバー専用。NEXT_PUBLIC_ を付けない／ブラウザに出さない／git にコミットしない。
# 管理者によるメンバーアカウント発行（auth.admin）に使用。
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...
